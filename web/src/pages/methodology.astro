---
import Layout from "../layouts/Layout.astro";
import { dataset } from "../lib/data";
import { formatUnit } from "../lib/format";
import DraftNotice from "../components/DraftNotice.astro";
import { loadMethodology } from "../lib/content";

const sources = Object.entries(dataset.sources);
const metrics = Object.entries(dataset.config.metrics);
const method = loadMethodology();

// Auto-generated from the data: how each metric's figures were produced.
const SUBJECT = "subject";
const howRows = metrics.map(([id, def]) => {
  const rows = dataset.metrics[id] ?? [];
  const uniq = (f: (r: (typeof rows)[number]) => string) => [
    ...new Set(rows.map(f)),
  ];
  const cholsey = rows.filter((r) => r.area_role === SUBJECT);
  return {
    label: def.label,
    methods: uniq((r) => r.method.replace(/_/g, " ")).join(", "),
    flags:
      uniq((r) => r.flag)
        .filter((f) => f !== "none")
        .map((f) => f.replace(/_/g, " "))
        .join(", ") || "none",
    cholseyGeography: cholsey.at(-1)?.geography_used ?? "not available",
  };
});
---

<Layout title="Methodology and sources">
  <h1>Methodology and sources</h1>
  <p>
    Every number on this site comes from the open datasets below. Values for
    Cholsey parish are often estimates apportioned from smaller or larger areas;
    each figure's source, geography, method and any estimate flag is shown
    beside it.
  </p>

  <DraftNotice status={method.status} />
  {
    method.sections.map((sec) => (
      <section>
        <h2>{sec.heading}</h2>
        {sec.paragraphs.map((p) => (
          <p>{p}</p>
        ))}
      </section>
    ))
  }

  <h2>How each figure was produced</h2>
  <div class="table-wrap">
    <table data-how-table>
      <caption
        >Method, estimate flags and geography used for Cholsey, generated from
        the data</caption
      >
      <thead>
        <tr>
          <th scope="col">Metric</th>
          <th scope="col">Methods used</th>
          <th scope="col">Flags</th>
          <th scope="col">Geography used for Cholsey</th>
        </tr>
      </thead>
      <tbody>
        {
          howRows.map((r) => (
            <tr>
              <th scope="row">{r.label}</th>
              <td>{r.methods}</td>
              <td>{r.flags}</td>
              <td>{r.cholseyGeography}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <h2>Metrics</h2>
  <ul>
    {
      metrics.map(([, m]) => (
        <li>
          {m.label} ({formatUnit(m.unit)}), {m.direction.replace(/_/g, " ")}
        </li>
      ))
    }
  </ul>

  <h2>Data sources</h2>
  {
    sources.map(([id, s]) => (
      <section aria-labelledby={`s-${id}`}>
        <h3 id={`s-${id}`}>{s.name}</h3>
        <dl>
          <dt>Publisher</dt>
          <dd>{s.publisher}</dd>
          <dt>Link</dt>
          <dd>
            <a href={s.url}>{s.url}</a>
          </dd>
          {s.resolution && (
            <>
              <dt>Resolution</dt>
              <dd>{s.resolution}</dd>
            </>
          )}
          {s.cadence && (
            <>
              <dt>Update cadence</dt>
              <dd>{s.cadence}</dd>
            </>
          )}
          {s.licence && (
            <>
              <dt>Licence</dt>
              <dd>{s.licence}</dd>
            </>
          )}
          {s.notes && (
            <>
              <dt>Notes</dt>
              <dd>{s.notes}</dd>
            </>
          )}
        </dl>
      </section>
    ))
  }
</Layout>
