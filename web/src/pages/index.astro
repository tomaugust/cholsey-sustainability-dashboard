---
import Layout from "../layouts/Layout.astro";
import ValueWithProvenance from "../components/ValueWithProvenance.astro";
import {
  dataset,
  getLatest,
  getReferenceRows,
  getTiles,
  href,
} from "../lib/data";
---

<Layout title="Overview">
  <h1>Cholsey Parish Sustainability Dashboard</h1>
  <p class="summary">
    How is Cholsey doing on trees, green space and the move to cleaner home
    energy, compared with nearby parishes, South Oxfordshire and England? A
    narrative summary will be written in Phase 6.
  </p>
  <ul class="tiles">
    {
      getTiles().map((tile) => (
        <li class="tile">
          <h2>
            <a href={href(`/metrics/${tile.id}/`)}>{tile.label}</a>
          </h2>
          {tile.metrics.map((m) => {
            const def = dataset.config.metrics[m];
            const { district, national } = getReferenceRows(m);
            return (
              <div class="tile-metric">
                {tile.metrics.length > 1 && <h3>{def.label}</h3>}
                <ValueWithProvenance
                  label="Cholsey"
                  row={getLatest(m, "E04012474")}
                />
                <div
                  class="slot sparkline-slot"
                  data-chart="sparkline"
                  data-metric={m}
                />
                <p class="slot indicator-slot">
                  Compared with district / England: indicator added in Phase 5.
                </p>
                <ValueWithProvenance label="South Oxfordshire" row={district} />
                <ValueWithProvenance label="England" row={national} />
              </div>
            );
          })}
        </li>
      ))
    }
  </ul>
</Layout>
