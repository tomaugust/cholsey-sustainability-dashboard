---
import "../styles/global.css";
import { href, getTiles, dataset } from "../lib/data";

interface Props {
  title: string;
}
const { title } = Astro.props;
const pageTitle = `${title} · Cholsey Parish Sustainability Dashboard`;
const nav = [
  { path: "/", label: "Overview" },
  ...getTiles().map((t) => ({ path: `/metrics/${t.id}/`, label: t.label })),
  { path: "/compare/", label: "Compare" },
  { path: "/methodology/", label: "Methodology" },
];
const attributions = [
  ...new Set(
    Object.values(dataset.sources)
      .map((s) => s.attribution_text)
      .filter((t): t is string => Boolean(t)),
  ),
];
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={href("/favicon.svg")} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <header>
      <p class="site-name">
        <a href={href("/")}>Cholsey Parish Sustainability Dashboard</a>
      </p>
      <nav aria-label="Main">
        <ul>
          {
            nav.map((n) => (
              <li>
                <a href={href(n.path)}>{n.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer>
      <p>
        Every figure links to its source; see the <a
          href={href("/methodology/")}>methodology</a
        >.
      </p>
      {attributions.map((t) => <p>{t}</p>)}
    </footer>
  </body>
</html>
