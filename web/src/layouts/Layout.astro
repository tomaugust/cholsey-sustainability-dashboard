---
import "../styles/global.css";
import { href, getTiles, dataset } from "../lib/data";
import {
  LAUNCHED,
  OGL_TEXT,
  OGL_URL,
  REPO_URL,
  SITE_DESCRIPTION,
  SITE_NAME,
  dataLastRefreshed,
} from "../lib/site";

interface Props {
  title: string;
}
const { title } = Astro.props;
const pageTitle = `${title} · ${SITE_NAME}`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const card = new URL(href("/social-card.png"), Astro.site).toString();
const refreshed = dataLastRefreshed();
const nav = [
  { path: "/", label: "Overview" },
  ...getTiles().map((t) => ({ path: `/metrics/${t.id}/`, label: t.label })),
  { path: "/compare/", label: "Compare" },
  { path: "/methodology/", label: "Methodology" },
  { path: "/glossary/", label: "Glossary" },
  { path: "/about/", label: "About" },
];
const attributions = [
  ...new Set(
    Object.values(dataset.sources)
      .map((s) => s.attribution_text)
      .filter((t): t is string => Boolean(t) && t !== OGL_TEXT),
  ),
];
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={href("/favicon.svg")} />
    <title>{pageTitle}</title>
    <meta name="description" content={SITE_DESCRIPTION} />
    <link rel="canonical" href={canonical} />
    {!LAUNCHED && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={SITE_DESCRIPTION} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={card} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <header>
      <p class="site-name">
        <a href={href("/")}>Cholsey Parish Sustainability Dashboard</a>
      </p>
      <nav aria-label="Main">
        <ul>
          {
            nav.map((n) => (
              <li>
                <a href={href(n.path)}>{n.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <script>
      // Provenance on interaction: hover/focus/tap on a chart mark shows its source.
      document.querySelectorAll<HTMLElement>(".chart").forEach((chart) => {
        const panel = chart.querySelector<HTMLElement>(".chart-detail");
        if (!panel) return;
        const show = (mark: Element) => {
          const src = document.getElementById(
            mark.getAttribute("data-prov-id") ?? "",
          );
          if (!src) return;
          const label = mark.getAttribute("aria-label") ?? "";
          panel.replaceChildren();
          const strong = document.createElement("strong");
          strong.textContent = label;
          const dl = src.querySelector("dl")?.cloneNode(true);
          panel.append(strong);
          if (dl) panel.append(dl);
        };
        chart.querySelectorAll(".mark").forEach((mark) => {
          ["mouseenter", "focus", "click"].forEach((ev) =>
            mark.addEventListener(ev, () => show(mark)),
          );
        });
      });
    </script>
    <script>
      // Council papers: print every expandable source and data table.
      const toggle = (open: boolean) =>
        document.querySelectorAll("details").forEach((d) => {
          if (open) d.dataset.wasOpen = String(d.open);
          d.open = open ? true : d.dataset.wasOpen === "true";
        });
      window.addEventListener("beforeprint", () => toggle(true));
      window.addEventListener("afterprint", () => toggle(false));
    </script>
    <footer>
      <p>
        Every figure links to its source; see the <a
          href={href("/methodology/")}>methodology</a
        >.
      </p>
      <p data-footer-ogl>
        {OGL_TEXT}
        <a href={OGL_URL}>Open Government Licence v3.0</a>
      </p>
      {attributions.map((t) => <p data-footer-attribution>{t}</p>)}
      <p>
        Data last refreshed: <time datetime={refreshed}>{refreshed}</time>. Code
        and data are open on
        <a href={REPO_URL}>GitHub</a>.
      </p>
    </footer>
  </body>
</html>
