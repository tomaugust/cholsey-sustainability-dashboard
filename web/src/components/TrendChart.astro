---
import {
  dataset,
  getComparisonAreas,
  getSeries,
  SUBJECT_CODE,
} from "../lib/data";
import { linear, niceTicks, pathFrom, provId } from "../lib/chart";
import { formatNumber, formatValue, flagLabel } from "../lib/format";
import { trendSummary } from "../lib/narrative";
import Provenance from "./Provenance.astro";

interface Props {
  metricId: string;
}
const { metricId } = Astro.props;
const def = dataset.config.metrics[metricId];
const W = 640;
const H = 300;
const M = { l: 56, r: 24, t: 12, b: 28 };

const series = getComparisonAreas()
  .map((code) => ({
    code,
    area: dataset.areas[code],
    rows: getSeries(metricId, code),
  }))
  .filter((s) => s.rows.length > 0);
const all = series.flatMap((s) => s.rows);
const years = all.map((r) => r.year);
const minY = Math.min(...years);
const maxY = Math.max(...years);
const { top, ticks } = niceTicks(Math.max(...all.map((r) => r.value)));
const x =
  maxY === minY
    ? linear([minY - 1, minY + 1], [M.l, W - M.r])
    : linear([minY, maxY], [M.l, W - M.r]);
const y = linear([0, top], [H - M.b, M.t]);
const xTicks = [...new Set(years)].filter(
  (yr) => (yr - minY) % 2 === 0 || maxY - minY < 4,
);

const style = (role: string) =>
  role === "subject"
    ? { stroke: "#0b5d3b", width: 3.5, dash: "", op: 1 }
    : role === "comparator"
      ? { stroke: "#6b6b6b", width: 1.25, dash: "", op: 0.8 }
      : role === "district"
        ? { stroke: "#1b4f9c", width: 2, dash: "6 3", op: 1 }
        : { stroke: "#222", width: 2, dash: "2 3", op: 1 };
const cholseyRows = getSeries(metricId, SUBJECT_CODE);
const sortedRows = series.flatMap((s) => s.rows);
---

<figure class="chart" data-chart="trend" data-metric={metricId}>
  <figcaption>
    <strong>{def.label}: trend</strong>
    <span data-chart-summary>{trendSummary(def.label, cholseyRows)}</span>
  </figcaption>
  <svg
    viewBox={`0 0 ${W} ${H}`}
    role="group"
    aria-label={`${def.label} trend chart`}
  >
    {
      ticks.map((t) => (
        <g>
          <line x1={M.l} x2={W - M.r} y1={y(t)} y2={y(t)} stroke="#ddd" />
          <text
            x={M.l - 6}
            y={y(t) + 4}
            text-anchor="end"
            font-size="11"
            fill="#444"
          >
            {formatNumber(t)}
          </text>
        </g>
      ))
    }
    {
      xTicks.map((yr) => (
        <text
          x={x(yr)}
          y={H - 8}
          text-anchor="middle"
          font-size="11"
          fill="#444"
        >
          {yr}
        </text>
      ))
    }
    {
      [...series]
        .sort(
          (a, b) =>
            (a.area.role === "subject" ? 1 : 0) -
            (b.area.role === "subject" ? 1 : 0),
        )
        .map((s) => {
          const st = style(s.area.role);
          const pts = s.rows.map((r): [number, number] => [
            x(r.year),
            y(r.value),
          ]);
          return (
            <g data-series={s.code} data-role={s.area.role} opacity={st.op}>
              {s.rows.length > 1 && (
                <path
                  d={pathFrom(pts)}
                  fill="none"
                  stroke={st.stroke}
                  stroke-width={st.width}
                  stroke-dasharray={st.dash}
                />
              )}
              {s.rows.map((r, i) => (
                <circle
                  class="mark"
                  cx={pts[i][0]}
                  cy={pts[i][1]}
                  r={s.area.role === "subject" ? 4 : 3}
                  fill={st.stroke}
                  tabindex="0"
                  role="img"
                  data-value
                  data-prov-id={provId("trend", r)}
                  aria-label={`${r.area_name}, ${r.year}: ${formatValue(r.value, r.unit)}`}
                >
                  <title>{`${r.area_name}, ${r.year}: ${formatValue(r.value, r.unit)} (${r.source_name}; ${r.geography_used})`}</title>
                </circle>
              ))}
            </g>
          );
        })
    }
  </svg>
  <ul class="legend">
    {
      series.map((s) => (
        <li data-legend={s.code}>
          <svg width="28" height="10" aria-hidden="true">
            <line
              x1="0"
              x2="28"
              y1="5"
              y2="5"
              stroke={style(s.area.role).stroke}
              stroke-width={style(s.area.role).width}
              stroke-dasharray={style(s.area.role).dash}
            />
          </svg>
          {s.area.name}
          {s.area.role === "subject" && " (Cholsey)"}
          {s.area.role === "district" && " (district)"}
          {s.area.role === "national" && " (national)"}
        </li>
      ))
    }
  </ul>
  <div class="chart-detail" aria-live="polite">
    Hover, focus or tap a point to see its source.
  </div>
  <details>
    <summary>Data table for this chart</summary>
    <div class="table-wrap">
      <table>
        <caption>{def.label} by area and year</caption>
        <thead>
          <tr
            ><th scope="col">Area</th><th scope="col">Year</th><th scope="col"
              >Value</th
            ><th scope="col">Source</th></tr
          >
        </thead>
        <tbody>
          {
            sortedRows.map((r) => (
              <tr>
                <th scope="row">{r.area_name}</th>
                <td>{r.year}</td>
                <td data-value data-prov-id={provId("trend", r)}>
                  {formatValue(r.value, r.unit)}
                  {r.flag !== "none" && (
                    <span class="flag">{flagLabel(r.flag)}</span>
                  )}
                </td>
                <td>
                  <Provenance row={r} id={provId("trend", r)} />
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </details>
</figure>
