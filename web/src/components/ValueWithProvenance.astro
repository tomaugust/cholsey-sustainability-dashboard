---
import type { MetricRow } from "../lib/types";
import { formatParts, formatLatestYearLabel, flagLabel } from "../lib/format";
import { provId } from "../lib/chart";
import Provenance from "./Provenance.astro";

interface Props {
  label: string;
  row?: MetricRow;
  /** Unique-per-page context, so provenance ids never collide. */
  ctx: string;
}
const { label, row, ctx } = Astro.props;
const id = row ? provId(ctx, row) : undefined;
const parts = row ? formatParts(row.value, row.unit) : undefined;
---

<div class="value-block">
  <span class="value-label">{label}</span>
  {
    row ? (
      <>
        <strong class="value" data-value data-prov-id={id}>
          <>
            <span
              data-countup={row.value}
              data-digits={parts!.digits}
              set:text={parts!.num}
            />
            <small
              class={
                parts!.suffix.length > 8
                  ? "unit-suffix unit-long"
                  : "unit-suffix"
              }
              set:text={parts!.suffix}
            />
          </>
        </strong>
        <span class="year" data-year-label={row.year}>
          {formatLatestYearLabel(row.year)}
        </span>
        {row.flag !== "none" && <span class="flag">{flagLabel(row.flag)}</span>}
        <Provenance row={row} id={id} />
      </>
    ) : (
      <span class="no-data">Not available</span>
    )
  }
</div>
