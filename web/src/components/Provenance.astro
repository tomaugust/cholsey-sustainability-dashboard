---
import type { MetricRow } from "../lib/types";
import { formatDate } from "../lib/format";

interface Props {
  row: MetricRow;
  id?: string;
}
const { row, id } = Astro.props;
---

<details class="provenance" id={id}>
  <summary>Source: {row.source_name} ({row.year})</summary>
  <dl>
    <dt>Source</dt>
    <dd data-field="source">
      <a href={row.source_url}>{row.source_name}</a>, {row.source_publisher}
    </dd>
    <dt>Year</dt>
    <dd data-field="year">{row.year}</dd>
    <dt>Geography used</dt>
    <dd data-field="geography">{row.geography_used}</dd>
    <dt>Method</dt>
    <dd data-field="method">{row.method}</dd>
    <dt>Flag</dt>
    <dd data-field="flag">
      {row.flag}{row.flag_note ? ` — ${row.flag_note}` : ""}
    </dd>
    <dt>Retrieved</dt>
    <dd>{formatDate(row.retrieved_at)}</dd>
  </dl>
</details>
