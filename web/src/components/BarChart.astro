---
import {
  dataset,
  getComparisonAreas,
  getLatest,
  SUBJECT_CODE,
} from "../lib/data";
import { linear, niceTicks, provId } from "../lib/chart";
import { formatNumber, formatValue, flagLabel } from "../lib/format";
import { rankSummary } from "../lib/narrative";
import Provenance from "./Provenance.astro";

interface Props {
  metricId: string;
}
const { metricId } = Astro.props;
const def = dataset.config.metrics[metricId];
const codes = getComparisonAreas();
const rows = codes
  .map((c) => getLatest(metricId, c))
  .filter((r) => r !== undefined);
const parishes = rows
  .filter((r) => r.area_role === "subject" || r.area_role === "comparator")
  .sort((a, b) => b.value - a.value);
const refs = rows.filter(
  (r) => r.area_role === "district" || r.area_role === "national",
);
const missing = codes
  .filter((c) => !rows.some((r) => r.area_code === c))
  .map((c) => dataset.areas[c].name);

const LW = 150;
const W = 640;
const rowH = 28;
const T = 8;
const B = 28;
const H = T + parishes.length * rowH + B;
const { top, ticks } = niceTicks(Math.max(...rows.map((r) => r.value)));
const x = linear([0, top], [LW, W - 40]);
const refStyle = (role: string) =>
  role === "district"
    ? { stroke: "#1b4f9c", dash: "6 3" }
    : { stroke: "#222", dash: "2 3" };
const tableRows = [...parishes, ...refs];
---

<figure class="chart" data-chart="bars" data-metric={metricId}>
  <figcaption>
    <strong>{def.label}: latest year by area</strong>
    <span data-chart-summary>{rankSummary(def.label, rows, SUBJECT_CODE)}</span>
  </figcaption>
  <svg
    viewBox={`0 0 ${W} ${H}`}
    role="group"
    aria-label={`${def.label} bar chart`}
  >
    {
      ticks.map((t) => (
        <g>
          <line x1={x(t)} x2={x(t)} y1={T} y2={H - B} stroke="#ddd" />
          <text
            x={x(t)}
            y={H - 10}
            text-anchor="middle"
            font-size="11"
            fill="#444"
          >
            {formatNumber(t)}
          </text>
        </g>
      ))
    }
    {
      parishes.map((r, i) => {
        const subject = r.area_role === "subject";
        const yy = T + i * rowH;
        return (
          <g
            class="mark"
            tabindex="0"
            role="img"
            data-series={r.area_code}
            data-role={r.area_role}
            data-value
            data-prov-id={provId("bars", r)}
            aria-label={`${r.area_name}, ${r.year}: ${formatValue(r.value, r.unit)}`}
          >
            <title>{`${r.area_name}, ${r.year}: ${formatValue(r.value, r.unit)} (${r.source_name}; ${r.geography_used})`}</title>
            <text
              x={LW - 6}
              y={yy + 17}
              text-anchor="end"
              font-size="12"
              font-weight={subject ? "700" : "400"}
            >
              {r.area_name}
            </text>
            <rect
              x={LW}
              y={yy + 4}
              width={Math.max(x(r.value) - LW, 1)}
              height={rowH - 8}
              fill={subject ? "#0b5d3b" : "#767676"}
            />
            <text x={x(r.value) + 4} y={yy + 17} font-size="11" fill="#222">
              {formatNumber(r.value)}
              {r.flag !== "none" ? ` (${flagLabel(r.flag).toLowerCase()})` : ""}
            </text>
          </g>
        );
      })
    }
    {
      refs.map((r) => {
        const st = refStyle(r.area_role);
        return (
          <g
            class="mark"
            tabindex="0"
            role="img"
            data-series={r.area_code}
            data-role={r.area_role}
            data-value
            data-prov-id={provId("bars", r)}
            aria-label={`${r.area_name} reference, ${r.year}: ${formatValue(r.value, r.unit)}`}
          >
            <title>{`${r.area_name}, ${r.year}: ${formatValue(r.value, r.unit)} (${r.source_name}; ${r.geography_used})`}</title>
            <line
              x1={x(r.value)}
              x2={x(r.value)}
              y1={T}
              y2={H - B}
              stroke={st.stroke}
              stroke-width="2.5"
              stroke-dasharray={st.dash}
            />
          </g>
        );
      })
    }
  </svg>
  <ul class="legend">
    <li>Green bar: Cholsey</li>
    <li>Grey bars: comparator parishes</li>
    {
      refs.map((r) => (
        <li data-legend={r.area_code}>
          <svg width="28" height="10" aria-hidden="true">
            <line
              x1="0"
              x2="28"
              y1="5"
              y2="5"
              stroke={refStyle(r.area_role).stroke}
              stroke-width="2.5"
              stroke-dasharray={refStyle(r.area_role).dash}
            />
          </svg>
          {r.area_name} ({r.area_role}): {formatValue(r.value, r.unit)},{" "}
          {r.year}
        </li>
      ))
    }
  </ul>
  {
    missing.length > 0 && (
      <p class="slot">No data available for: {missing.join(", ")}.</p>
    )
  }
  <div class="chart-detail" aria-live="polite">
    Hover, focus or tap a bar or line to see its source.
  </div>
  <details>
    <summary>Data table for this chart</summary>
    <div class="table-wrap">
      <table>
        <caption>Latest {def.label.toLowerCase()} by area</caption>
        <thead>
          <tr
            ><th scope="col">Area</th><th scope="col">Value</th><th scope="col"
              >Source</th
            ></tr
          >
        </thead>
        <tbody>
          {
            tableRows.map((r) => (
              <tr>
                <th scope="row">{r.area_name}</th>
                <td data-value data-prov-id={provId("bars", r)}>
                  {formatValue(r.value, r.unit)} ({r.year})
                  {r.flag !== "none" && (
                    <span class="flag">{flagLabel(r.flag)}</span>
                  )}
                </td>
                <td>
                  <Provenance row={r} id={provId("bars", r)} />
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </details>
</figure>
