---
import {
  dataset,
  getLatest,
  getReferenceRows,
  SUBJECT_CODE,
} from "../lib/data";
import { formatUnit } from "../lib/format";
import ValueWithProvenance from "./ValueWithProvenance.astro";
import TrendChart from "./TrendChart.astro";
import BarChart from "./BarChart.astro";
import Indicator from "./Indicator.astro";
import DraftNotice from "./DraftNotice.astro";
import { loadMetricContent } from "../lib/content";

interface Props {
  metricId: string;
  headingLevel?: "h2" | "h3";
}
const { metricId, headingLevel = "h2" } = Astro.props;
const def = dataset.config.metrics[metricId];
const Heading = headingLevel;
const cholsey = getLatest(metricId, SUBJECT_CODE);
const { district, national } = getReferenceRows(metricId);
const content = loadMetricContent(metricId);
const hasComparators = Object.entries(dataset.areas).some(
  ([code, a]) => a.role === "comparator" && getLatest(metricId, code),
);
---

<section aria-labelledby={`m-${metricId}`} data-metric-section={metricId}>
  <Heading id={`m-${metricId}`}>{def.label}</Heading>
  <p class="unit">Unit: {formatUnit(def.unit)}</p>

  <div class="reference-points">
    <ValueWithProvenance label="Cholsey" row={cholsey} ctx="ref" />
    <ValueWithProvenance
      label="South Oxfordshire (district)"
      row={district}
      ctx="ref"
    />
    <ValueWithProvenance label="England" row={national} ctx="ref" />
  </div>
  <Indicator metricId={metricId} />
  {
    !hasComparators && (
      <p class="slot" data-comparator-gap>
        No comparator-parish data is available for this metric (an accepted
        source gap, ADR-0007), so only the district is shown beside Cholsey.
      </p>
    )
  }

  <h3>Trend</h3>
  <TrendChart metricId={metricId} />

  <h3>Comparison with other areas</h3>
  <BarChart metricId={metricId} />

  <h3>What this means</h3>
  <DraftNotice status={content.status} />
  <div class="prose" data-content="what-this-means">
    {content.what_this_means.split(/\n\s*\n/).map((p) => <p>{p}</p>)}
  </div>

  <h3>Opportunities</h3>
  <ul class="opportunities" data-content="opportunities">
    {
      content.opportunities.map((o) => (
        <li>
          <a href={o.url}>{o.title}</a>
          <span class="provider"> ({o.provider})</span>
          <p>{o.description}</p>
          <p class="slot">Link last checked {o.last_checked}</p>
        </li>
      ))
    }
  </ul>
</section>
