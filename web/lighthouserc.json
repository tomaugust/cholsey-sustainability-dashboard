{
  "ci": {
    "collect": {
      "startServerCommand": "npm run preview -- --port 4322",
      "startServerReadyPattern": "4322",
      "url": [
        "http://localhost:4322/cholsey-sustainability-dashboard/",
        "http://localhost:4322/cholsey-sustainability-dashboard/metrics/home_energy/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
